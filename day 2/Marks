#include <iostream>
#include <string>
using namespace std;
class Student {
    public:
     string name;
     int marks;
     Student() { name="Unknown";marks=0; }
     Student(string n,int m) { name=n;marks=m; }
     void display() {
         cout<<name<<":"<<marks<<endl;
     }
};
int  main() {
    Student batch1[3]= {
        Student("Pavan",66),
        Student("Mohan",66),
        Student("Prajwal",66)
    };
    cout<<"Batch 1(stack array):"<<endl;
    for(int i=0;i<3;i++) {
      batch1[i].display();
    }
    Student* batch2=new Student[3] {
    Student("Pavana",77),
    Student("Mohana",77),
    Student("_Prajwalla",77)
};
cout<<"\nBatch 2(Heap array):"<<endl;
for(int i=0;i<3;i++) {
    batch2[i].display();
}
delete[] batch2;
return 0;
}