#include <iostream>
using namespace std;

class point {
    private:
    const int y;
    const int x;
    
    public:
    point(int xVal,int yVal): x(xVal),y(yVal)
    {
        cout << "Point (" << x << "," << y << ")created" << endl;
        
    }
    void display() const {
        cout<<"("<<x<<","<<y<<")"<<endl;
    }
};
int main ()
{
    point p1(10,20);
    point p2(-5,-15);
    
    p1.display();
    p2.display();
    return 0;
    
    
}