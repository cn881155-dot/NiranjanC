#include <iostream>
#include <string>
using namespace std;
class employee
{
private:
    string name;
    int id;
    double salary;
    string department;

public:
    employee(int i, string n, double s, string d)
    {
        id = i;
        setname(n);
        setsalary(s);
        department = d;
    }
    int getid() const { return id; }
    string getname() const { return name; }
    double getsalary() const { return salary; }
    string getdepartment() const { return department; }
    void setname(const string &n)
    {
        if (!n.empty())
        {
            name = n;
        }
        else
        {
            cout << "Invalid name" << endl;
        }
    }
    void setsalary(double s)
    {
        if (s >= 0)
        {
            salary = s;
        }
        else
        {
            cout << "Invalid salary" << endl;
        }
    }
    void setdepartment(const string &d)
    {
        department = d; // Assuming any department name is valid
    }
};
int main()
{
    employee e1(101, "John Doe", 50000, "HR");
    cout << "Employee ID: " << e1.getid() << endl;
    cout << "Name: " << e1.getname() << endl;
    cout << "Salary: " << e1.getsalary() << endl;
    cout << "Department: " << e1.getdepartment() << endl;
    e1.setname("");              // Testing invalid name
    e1.setsalary(-1000);         // Testing invalid salary
    e1.setdepartment("Finance"); // Testing valid department
    return 0;
}
