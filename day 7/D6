#include<iostream>
#include<string>
#include<vector>
#include<algorithm>
using namespace std;
template<typename T>
class ScoreManager {
    private:
        vector<T> scores;
    public:
        void addScore(T score) {
            scores.push_back(score);
        }
        T getAverage() const {
            if (scores.empty()) return T();
            T sum = 0;
            for(T score : scores) sum += score;
            return sum / scores.size();
        }
        T getHighest() {
            return *max_element(scores.begin(), scores.end());
        }
        T getLowest() {
            return *min_element(scores.begin(), scores.end());
        }
        void displayAll() {
            cout<<"Scores: ";
            for(T s : scores) cout<<s<<" ";
            cout<<endl;
        }
        int getCount() const {
            return scores.size();
        }
};
